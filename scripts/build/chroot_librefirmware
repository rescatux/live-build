set -e

# Including common functions
[ -e "${LIVE_BUILD}/scripts/build.sh" ] && . "${LIVE_BUILD}/scripts/build.sh" || . /usr/lib/live/build.sh

# Setting static variables
DESCRIPTION="Set non-free-firmware modules blacklist"
USAGE="${PROGRAM} [--force]"

# Processing arguments and configuration files
Init_config_data "${@}"

# Requiring stage file
Require_stagefiles config bootstrap

case "${LB_LIBREFIRMWARE}" in
	enable)
		Echo_message "Begin creating non-free-firmware modules blacklist..."

		# Checking stage file
		Check_stagefile

		# Acquire lock file
		Acquire_lockfile

		AMD_BLACKLISTED_MODULES=$(cat chroot/usr/share/metainfo/firmware-amd-graphics.metainfo.xml | grep -E 'firmware.*runtime.*firmware' | awk -F '>' '{print $2}' | awk -F '>' '{print $1}' | awk -F '<' '{print $1}' | grep '/' | awk -F '/' '{print $1}' | sort | uniq | paste -sd, -)
		MISC_BLACKLISTED_MODULES=$(cat chroot/usr/share/metainfo/firmware-misc-nonfree.metainfo.xml | grep -E 'firmware.*runtime.*firmware' | awk -F '>' '{print $2}' | awk -F '>' '{print $1}' | awk -F '<' '{print $1}' | grep '/' | awk -F '/' '{print $1}' | sort | uniq | paste -sd, -)
		ALL_BLACKLISTED_MODULES="${AMD_BLACKLISTED_MODULES},${MISC_BLACKLISTED_MODULES}"
		echo "${ALL_BLACKLISTED_MODULES}" > chroot/boot/nonfreefirmware-blacklisted-modules.txt

	;;

	disable)
	;;

esac

# Creating stage file
Create_stagefile
